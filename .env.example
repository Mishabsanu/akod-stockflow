# Copy to .env.local for development. In production set these in the host's environment.

# MongoDB connection string (database name at the end).
# Use a replica set or Atlas in production — stock and payment transactions need it.
MONGODB_URI=mongodb://127.0.0.1:27017/akod_dms

# Signs login sessions. Long random value, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Used once by `npm run seed` to create the first Super Admin.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@akodgroup.com
SEED_ADMIN_MOBILE=+91 98765 43210
SEED_ADMIN_PASSWORD=

# Printed on delivery challans
COMPANY_NAME=AKOD Group
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_GSTIN=
