# Copy to .env.local for development. In production set these in the host's environment.

# MongoDB connection string (database name at the end).
# Use a replica set or Atlas in production — stock and payment transactions need it.
MONGODB_URI=mongodb://127.0.0.1:27017/akod_eco

# Signs login sessions. Long random value, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Used once by `npm run seed` to create the Super Admin (only role and user it creates).
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@akod.com
SEED_ADMIN_MOBILE=+91 98765 43210
SEED_ADMIN_PASSWORD=

# Defaults for Settings → Company (printed on orders)
COMPANY_NAME=AKOD Group
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_GSTIN=

# Cloudinary (product photos and other uploads). Files go to <CLOUDINARY_FOLDER>/products,
# <CLOUDINARY_FOLDER>/product_variants, ... in your Cloudinary media library.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=akod-eco

# Public storefront catalog (GET /api/storefront/catalog, used by akod-food).
# Optional: when set, the store must send the same value in the `x-storefront-key` header.
STOREFRONT_API_KEY=

# Instant store refresh: after a product / offer / category / stock change, AKOD ECO calls the store
# so the change shows within seconds. URL of the store's refresh endpoint, and the same secret as
# REVALIDATE_SECRET on the store. Leave empty to rely on the store's timed refresh only.
STOREFRONT_REVALIDATE_URL=http://localhost:3002/api/revalidate
STOREFRONT_REVALIDATE_SECRET=
